{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michaelwave369.github.io/parallax-369-public-primer/schemas/report-input.schema.json",
  "title": "Parallax 3-6-9 Local Proving Report Input",
  "description": "Structured input for the local-only Markdown report generator. Generation does not authorize release.",
  "type": "object",
  "required": [
    "schema_file",
    "schema_version",
    "project",
    "candidate",
    "controlling_specification",
    "tester",
    "test_date",
    "environment",
    "criteria",
    "limitations"
  ],
  "properties": {
    "schema_file": {
      "type": "string",
      "const": "schemas/report-input.schema.json"
    },
    "schema_version": {
      "type": "string",
      "const": "0.3"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "type": "string",
      "minLength": 1
    },
    "controlling_specification": {
      "type": "string",
      "minLength": 1
    },
    "tester": {
      "type": "string",
      "minLength": 1
    },
    "test_date": {
      "type": "string",
      "minLength": 10
    },
    "environment": {
      "type": "object",
      "required": ["platform", "configuration"],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        },
        "external_services": {
          "type": "string"
        },
        "safety_controls": {
          "type": "string"
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "criterion", "method", "result", "observation", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": ["pass", "fail", "blocked", "inconclusive", "not-run"]
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "classification", "scope_limit"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": ["observed", "repeated", "verified-in-scope", "unsupported", "unknown"]
          },
          "scope_limit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
